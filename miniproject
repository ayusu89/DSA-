<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Student Registrar Desk — DSA Mini Project</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Zilla+Slab:wght@400;600;700&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --ink:#1F3A2E;
    --ink-soft:#2C4A3B;
    --paper:#F2EFE6;
    --paper-card:#FFFDF7;
    --brass:#C98A3B;
    --brass-dark:#A56F28;
    --red:#B23A32;
    --red-soft:#F4E1DF;
    --green-soft:#E1EBE3;
    --slate:#2B2B28;
    --slate-soft:#6B675C;
    --line:#D9D3C1;
    --radius:10px;
    --shadow: 0 1px 2px rgba(31,58,46,0.06), 0 6px 20px rgba(31,58,46,0.08);
    --font-display:'Zilla Slab', serif;
    --font-body:'Inter', sans-serif;
    --font-mono:'IBM Plex Mono', monospace;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    background:var(--paper);
    background-image:
      radial-gradient(circle at 1px 1px, rgba(31,58,46,0.05) 1px, transparent 0);
    background-size: 22px 22px;
    color:var(--slate);
    font-family:var(--font-body);
    min-height:100vh;
  }
  #app{min-height:100vh;display:flex;flex-direction:column;}
  button{font-family:inherit;cursor:pointer;}
  input, select{font-family:inherit;}
  :focus-visible{outline:3px solid var(--brass); outline-offset:2px;}

  /* ---------- Top ribbon ---------- */
  .ribbon{
    background:var(--ink);
    color:var(--paper-card);
    padding:14px 28px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    box-shadow: var(--shadow);
  }
  .brand{display:flex;align-items:center;gap:12px;}
  .brand-mark{
    width:34px;height:34px;border-radius:50%;
    background:var(--brass);
    display:flex;align-items:center;justify-content:center;
    font-family:var(--font-display); font-weight:700; color:var(--ink);
    font-size:16px;
  }
  .brand-text h1{font-family:var(--font-display); font-size:18px; margin:0; letter-spacing:0.3px;}
  .brand-text span{font-size:11px; color:#C9D6CC; letter-spacing:1.5px; text-transform:uppercase;}
  .logout-btn{
    background:transparent; border:1px solid rgba(255,255,255,0.35); color:var(--paper-card);
    padding:8px 16px; border-radius:999px; font-size:13px; font-weight:600;
    transition:background .15s ease, border-color .15s ease;
  }
  .logout-btn:hover{background:rgba(255,255,255,0.1); border-color:rgba(255,255,255,0.6);}

  /* ---------- Login screen ---------- */
  #loginScreen{
    flex:1; display:flex; align-items:center; justify-content:center; padding:24px;
  }
  .badge-card{
    width:100%; max-width:380px;
    background:var(--paper-card);
    border-radius:var(--radius);
    box-shadow:var(--shadow);
    border:1px solid var(--line);
    overflow:hidden;
  }
  .badge-strip{
    background:repeating-linear-gradient(135deg, var(--brass), var(--brass) 10px, var(--brass-dark) 10px, var(--brass-dark) 20px);
    height:10px;
  }
  .badge-body{padding:32px 30px 28px;}
  .badge-body .brand-mark{margin:0 auto 14px; width:52px; height:52px; font-size:22px;}
  .badge-body h2{
    font-family:var(--font-display); text-align:center; margin:0 0 4px; font-size:22px; color:var(--ink);
  }
  .badge-body p.sub{
    text-align:center; color:var(--slate-soft); font-size:13px; margin:0 0 26px;
  }
  .field{margin-bottom:16px;}
  .field label{
    display:block; font-size:12px; font-weight:600; text-transform:uppercase;
    letter-spacing:0.6px; color:var(--ink-soft); margin-bottom:6px;
  }
  .field input, .field select{
    width:100%; padding:10px 12px; border:1.5px solid var(--line); border-radius:7px;
    font-size:14px; background:#fff; color:var(--slate);
    transition:border-color .15s ease;
  }
  .field input:focus, .field select:focus{border-color:var(--brass);}
  .field small.err{
    display:block; color:var(--red); font-size:12px; margin-top:5px; min-height:14px;
  }
  .primary-btn{
    width:100%; background:var(--ink); color:var(--paper-card); border:none;
    padding:12px; border-radius:7px; font-weight:600; font-size:14px;
    letter-spacing:0.3px; transition:background .15s ease, transform .1s ease;
  }
  .primary-btn:hover{background:var(--ink-soft);}
  .primary-btn:active{transform:scale(0.99);}
  .hint{
    text-align:center; font-size:11.5px; color:var(--slate-soft); margin-top:16px;
    font-family:var(--font-mono);
    background:var(--paper); border:1px dashed var(--line); border-radius:6px; padding:8px;
  }
  .login-error{
    background:var(--red-soft); color:var(--red); font-size:13px; padding:9px 12px;
    border-radius:7px; margin-bottom:16px; display:none; font-weight:500;
  }

  /* ---------- Main screen ---------- */
  #mainScreen{display:none; flex:1; flex-direction:column;}
  .layout{
    max-width:980px; margin:0 auto; padding:30px 20px 60px; width:100%;
  }
  .page-head{margin-bottom:26px;}
  .page-head .eyebrow{
    font-family:var(--font-mono); font-size:12px; color:var(--brass-dark); letter-spacing:1.5px;
    text-transform:uppercase; margin:0 0 6px;
  }
  .page-head h2{font-family:var(--font-display); font-size:26px; margin:0; color:var(--ink);}
  .page-head p{color:var(--slate-soft); margin:6px 0 0; font-size:14px;}

  .card{
    background:var(--paper-card); border:1px solid var(--line); border-radius:var(--radius);
    box-shadow:var(--shadow); padding:24px 26px; margin-bottom:28px;
  }
  .card-title{
    font-family:var(--font-display); font-size:18px; color:var(--ink); margin:0 0 4px;
    display:flex; align-items:center; gap:8px;
  }
  .card-title .dot{width:8px;height:8px;border-radius:50%;background:var(--brass);display:inline-block;}
  .card-subtitle{font-size:12.5px; color:var(--slate-soft); margin:0 0 20px;}

  .form-grid{display:grid; grid-template-columns:1fr 1fr; gap:16px 18px;}
  .form-grid .field.full{grid-column:1 / -1;}
  @media (max-width:640px){ .form-grid{grid-template-columns:1fr;} }

  .form-actions{display:flex; gap:10px; margin-top:6px;}
  .btn{
    padding:11px 20px; border-radius:7px; font-weight:600; font-size:13.5px; border:none;
    transition:background .15s ease, transform .1s ease;
  }
  .btn:active{transform:scale(0.98);}
  .btn-submit{background:var(--ink); color:var(--paper-card);}
  .btn-submit:hover{background:var(--ink-soft);}
  .btn-cancel{background:transparent; color:var(--slate-soft); border:1.5px solid var(--line);}
  .btn-cancel:hover{border-color:var(--slate-soft); color:var(--slate);}

  .editing-flag{
    display:none; align-items:center; gap:8px; background:#FFF3DE; color:var(--brass-dark);
    font-size:12.5px; font-weight:600; padding:8px 12px; border-radius:7px; margin-bottom:16px;
  }

  /* ---------- Queue meta strip ---------- */
  .queue-meta{
    display:flex; gap:14px; flex-wrap:wrap; margin-bottom:16px;
  }
  .meta-pill{
    font-family:var(--font-mono); font-size:12px; background:var(--paper); border:1px solid var(--line);
    padding:7px 12px; border-radius:999px; color:var(--ink-soft); display:flex; align-items:center; gap:6px;
  }
  .meta-pill b{color:var(--ink); font-weight:600;}

  /* ---------- Table / ticket rows ---------- */
  .table-wrap{overflow-x:auto;}
  table{width:100%; border-collapse:collapse; min-width:760px;}
  thead th{
    text-align:left; font-size:11px; text-transform:uppercase; letter-spacing:0.7px;
    color:var(--slate-soft); font-weight:600; padding:0 12px 10px; border-bottom:2px solid var(--line);
  }
  tbody td{
    padding:14px 12px; border-bottom:1px solid var(--line); font-size:13.5px; vertical-align:middle;
  }
  tbody tr{animation:ticketIn .35s ease both;}
  @keyframes ticketIn{
    from{opacity:0; transform:translateX(14px);}
    to{opacity:1; transform:translateX(0);}
  }
  @media (prefers-reduced-motion:reduce){
    tbody tr{animation:none;}
  }

  .token{
    display:inline-flex; align-items:center; justify-content:center;
    font-family:var(--font-mono); font-weight:600; font-size:12.5px;
    color:var(--brass-dark); background:#FFF7EA;
    border:1px dashed var(--brass); border-radius:6px;
    padding:4px 8px; min-width:52px;
  }
  .tag{
    font-size:9.5px; font-weight:700; letter-spacing:0.5px; text-transform:uppercase;
    padding:2px 6px; border-radius:4px; margin-left:6px; vertical-align:middle;
  }
  .tag-front{background:var(--green-soft); color:var(--ink);}
  .tag-rear{background:#E4E9F0; color:#3A4A63;}

  .name-cell{font-weight:600; color:var(--slate);}
  .sub-cell{display:block; font-size:11.5px; color:var(--slate-soft); font-weight:400; margin-top:2px;}
  .mono-cell{font-family:var(--font-mono); font-size:12.5px; color:var(--slate);}

  .row-actions{display:flex; gap:6px;}
  .icon-btn{
    background:transparent; border:1.5px solid var(--line); border-radius:6px;
    width:32px; height:32px; display:inline-flex; align-items:center; justify-content:center;
    font-size:14px; color:var(--slate-soft); transition:all .15s ease;
  }
  .icon-btn:hover{border-color:var(--brass); color:var(--brass-dark); background:#FFF7EA;}
  .icon-btn.danger:hover{border-color:var(--red); color:var(--red); background:var(--red-soft);}

  .empty-state{
    text-align:center; padding:50px 20px; color:var(--slate-soft);
  }
  .empty-state .glyph{font-size:34px; margin-bottom:10px;}
  .empty-state p{margin:4px 0; font-size:13.5px;}

  footer{
    text-align:center; font-size:11.5px; color:var(--slate-soft); padding:18px; font-family:var(--font-mono);
  }
</style>
</head>
<body>
<div id="app">

  <!-- ===================== LOGIN SCREEN ===================== -->
  <div id="loginScreen">
    <div class="badge-card">
      <div class="badge-strip"></div>
      <div class="badge-body">
        <div class="brand-mark">SR</div>
        <h2>Registrar Desk Login</h2>
        <p class="sub">DSA Mini Project — Student Record Queue</p>

        <div class="login-error" id="loginError"></div>

        <form id="loginForm" novalidate>
          <div class="field">
            <label for="loginUser">Username</label>
            <input id="loginUser" type="text" autocomplete="username" placeholder="admin">
          </div>
          <div class="field">
            <label for="loginPass">Password</label>
            <input id="loginPass" type="password" autocomplete="current-password" placeholder="••••••••">
          </div>
          <button type="submit" class="primary-btn">Sign in</button>
        </form>

        <div class="hint">demo login → username: admin · password: dsa2082</div>
      </div>
    </div>
  </div>

  <!-- ===================== MAIN SCREEN ===================== -->
  <div id="mainScreen">
    <div class="ribbon">
      <div class="brand">
        <div class="brand-mark">SR</div>
        <div class="brand-text">
          <h1>Student Registrar Desk</h1>
          <span>FIFO Queue &middot; CRUD Demo</span>
        </div>
      </div>
      <button class="logout-btn" id="logoutBtn">Log out</button>
    </div>

    <div class="layout">
      <div class="page-head">
        <p class="eyebrow">2nd Semester &middot; Data Structures &amp; Algorithms</p>
        <h2>Student Enrollment Queue</h2>
        <p>Every submission joins the back of the queue. The registrar always processes the front first — First-In, First-Out.</p>
      </div>

      <!-- ---- Form card ---- -->
      <div class="card">
        <h3 class="card-title"><span class="dot"></span>Student Details</h3>
        <p class="card-subtitle">Fill in the form to enqueue a new record, or update one you're currently editing.</p>

        <div class="editing-flag" id="editingFlag">✎ Editing token <span id="editingToken">—</span> — submitting will update this record in place.</div>

        <form id="studentForm" novalidate>
          <div class="form-grid">
            <div class="field">
              <label for="fullName">Full Name</label>
              <input id="fullName" type="text" placeholder="e.g. Aarav Sharma">
              <small class="err" id="err-fullName"></small>
            </div>
            <div class="field">
              <label for="rollNo">Class Roll No.</label>
              <input id="rollNo" type="text" placeholder="e.g. 22">
              <small class="err" id="err-rollNo"></small>
            </div>
            <div class="field">
              <label for="faculty">Faculty / Program</label>
              <select id="faculty">
                <option value="">Select program</option>
                <option>Computer Engineering</option>
                <option>Electronics &amp; Communication Engineering</option>
                <option>Civil Engineering</option>
                <option>Electrical Engineering</option>
                <option>Software Engineering</option>
              </select>
              <small class="err" id="err-faculty"></small>
            </div>
            <div class="field">
              <label for="semester">Semester</label>
              <select id="semester">
                <option value="">Select semester</option>
                <option>1st</option><option>2nd</option><option>3rd</option><option>4th</option>
                <option>5th</option><option>6th</option><option>7th</option><option>8th</option>
              </select>
              <small class="err" id="err-semester"></small>
            </div>
            <div class="field">
              <label for="email">Email Address</label>
              <input id="email" type="text" placeholder="student@example.com">
              <small class="err" id="err-email"></small>
            </div>
            <div class="field">
              <label for="contact">Contact Number</label>
              <input id="contact" type="text" placeholder="+977 98XXXXXXXX">
              <small class="err" id="err-contact"></small>
            </div>
          </div>

          <div class="form-actions">
            <button type="submit" class="btn btn-submit" id="submitBtn">Enqueue Student</button>
            <button type="button" class="btn btn-cancel" id="cancelEditBtn" style="display:none;">Cancel edit</button>
          </div>
        </form>
      </div>

      <!-- ---- Queue display card ---- -->
      <div class="card">
        <h3 class="card-title"><span class="dot"></span>Submitted Records</h3>
        <p class="card-subtitle">Shown in FIFO order — the first student submitted sits at the front of the queue.</p>

        <div class="queue-meta">
          <span class="meta-pill">Queue size: <b id="metaSize">0</b></span>
          <span class="meta-pill">Front (next served): <b id="metaFront">—</b></span>
          <span class="meta-pill">Rear (last joined): <b id="metaRear">—</b></span>
        </div>

        <div class="table-wrap">
          <table id="studentTable">
            <thead>
              <tr>
                <th>Token</th>
                <th>Name / Roll</th>
                <th>Program</th>
                <th>Semester</th>
                <th>Email</th>
                <th>Contact</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody id="tableBody"></tbody>
          </table>
        </div>

        <div class="empty-state" id="emptyState" style="display:none;">
          <div class="glyph">🎫</div>
          <p><strong>The queue is empty.</strong></p>
          <p>Submit the form above to enqueue the first student.</p>
        </div>
      </div>
    </div>

    <footer>Data lives in memory for this session only — refreshing clears the queue.</footer>
  </div>

</div>

<script>
(function(){
  "use strict";

  /* =========================================================
     DATA STRUCTURE
     `queue` is a plain array used as an array-backed Queue.
       enqueue(record)  -> queue.push(record)      // join the rear
       dequeue()        -> queue.shift()           // leave from the front
       peekFront()      -> queue[0]
       peekRear()       -> queue[queue.length - 1]
     Delete/Update by id are provided for the CRUD requirement,
     but the *display order* always reflects FIFO submission order.
  ========================================================= */
  let queue = [];
  let nextToken = 1;
  let editingId = null; // id currently being updated, or null when adding new

  /* ---------------- Validation ---------------- */
  const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[a-zA-Z]{2,}$/;
  // Nepali mobile: optional +977 / 977 prefix, then must start 97 or 98, then 8 more digits
  const CONTACT_RE = /^(?:\+977[-\s]?|977[-\s]?)?(9[78]\d{8})$/;

  function validateEmail(v){ return EMAIL_RE.test(v.trim()); }
  function validateContact(v){ return CONTACT_RE.test(v.trim().replace(/\s+/g,' ').trim()); }
  function normalizeContact(v){
    const m = v.trim().match(CONTACT_RE);
    return m ? '+977 ' + m[1] : v.trim();
  }

  /* ---------------- Elements ---------------- */
  const loginScreen = document.getElementById('loginScreen');
  const mainScreen  = document.getElementById('mainScreen');
  const loginForm   = document.getElementById('loginForm');
  const loginError  = document.getElementById('loginError');
  const logoutBtn   = document.getElementById('logoutBtn');

  const studentForm  = document.getElementById('studentForm');
  const fullNameEl   = document.getElementById('fullName');
  const rollNoEl     = document.getElementById('rollNo');
  const facultyEl    = document.getElementById('faculty');
  const semesterEl   = document.getElementById('semester');
  const emailEl      = document.getElementById('email');
  const contactEl    = document.getElementById('contact');

  const submitBtn      = document.getElementById('submitBtn');
  const cancelEditBtn  = document.getElementById('cancelEditBtn');
  const editingFlag    = document.getElementById('editingFlag');
  const editingToken   = document.getElementById('editingToken');

  const tableBody   = document.getElementById('tableBody');
  const emptyState  = document.getElementById('emptyState');
  const metaSize    = document.getElementById('metaSize');
  const metaFront   = document.getElementById('metaFront');
  const metaRear    = document.getElementById('metaRear');

  /* ---------------- Auth (demo only, hardcoded) ---------------- */
  const DEMO_USER = 'admin';
  const DEMO_PASS = 'dsa2082';

  loginForm.addEventListener('submit', function(e){
    e.preventDefault();
    const u = document.getElementById('loginUser').value.trim();
    const p = document.getElementById('loginPass').value;
    if(u === DEMO_USER && p === DEMO_PASS){
      loginError.style.display = 'none';
      loginScreen.style.display = 'none';
      mainScreen.style.display = 'flex';
    } else {
      loginError.textContent = 'Incorrect username or password. Try again.';
      loginError.style.display = 'block';
    }
  });

  logoutBtn.addEventListener('click', function(){
    mainScreen.style.display = 'none';
    loginScreen.style.display = 'flex';
    loginForm.reset();
  });

  /* ---------------- Form field errors ---------------- */
  function setError(fieldId, msg){
    document.getElementById('err-' + fieldId).textContent = msg || '';
  }
  function clearErrors(){
    ['fullName','rollNo','faculty','semester','email','contact'].forEach(f => setError(f, ''));
  }

  /* ---------------- CRUD: Create / Update ---------------- */
  studentForm.addEventListener('submit', function(e){
    e.preventDefault();
    clearErrors();

    const name = fullNameEl.value.trim();
    const roll = rollNoEl.value.trim();
    const faculty = facultyEl.value;
    const semester = semesterEl.value;
    const email = emailEl.value.trim();
    const contact = contactEl.value.trim();

    let valid = true;
    if(!name){ setError('fullName', 'Name is required.'); valid = false; }
    if(!roll){ setError('rollNo', 'Roll number is required.'); valid = false; }
    if(!faculty){ setError('faculty', 'Please select a program.'); valid = false; }
    if(!semester){ setError('semester', 'Please select a semester.'); valid = false; }
    if(!email){ setError('email', 'Email is required.'); valid = false; }
    else if(!validateEmail(email)){ setError('email', 'Enter a valid email address.'); valid = false; }
    if(!contact){ setError('contact', 'Contact number is required.'); valid = false; }
    else if(!validateContact(contact)){
      setError('contact', 'Must start with 97 or 98 (country code +977), e.g. +977 98XXXXXXXX.');
      valid = false;
    }

    if(!valid) return;

    if(editingId !== null){
      // ---- Update in place, position in queue is unchanged ----
      const rec = queue.find(r => r.id === editingId);
      if(rec){
        rec.name = name; rec.roll = roll; rec.faculty = faculty;
        rec.semester = semester; rec.email = email; rec.contact = normalizeContact(contact);
      }
      exitEditMode();
    } else {
      // ---- enqueue(): new record joins the rear of the queue ----
      queue.push({
        id: nextToken++,
        name, roll, faculty, semester, email,
        contact: normalizeContact(contact),
        submittedAt: new Date()
      });
    }

    studentForm.reset();
    render();
  });

  cancelEditBtn.addEventListener('click', function(){
    exitEditMode();
    studentForm.reset();
    clearErrors();
  });

  function enterEditMode(rec){
    editingId = rec.id;
    fullNameEl.value = rec.name;
    rollNoEl.value = rec.roll;
    facultyEl.value = rec.faculty;
    semesterEl.value = rec.semester;
    emailEl.value = rec.email;
    contactEl.value = rec.contact;

    submitBtn.textContent = 'Update Student';
    cancelEditBtn.style.display = 'inline-block';
    editingFlag.style.display = 'flex';
    editingToken.textContent = '#' + String(rec.id).padStart(3, '0');
    studentForm.scrollIntoView({behavior: 'smooth', block: 'start'});
  }

  function exitEditMode(){
    editingId = null;
    submitBtn.textContent = 'Enqueue Student';
    cancelEditBtn.style.display = 'none';
    editingFlag.style.display = 'none';
  }

  /* ---------------- CRUD: Delete ---------------- */
  function deleteStudent(id){
    queue = queue.filter(r => r.id !== id);
    if(editingId === id) { exitEditMode(); studentForm.reset(); }
    render();
  }

  /* ---------------- Render (Read) ---------------- */
  function render(){
    tableBody.innerHTML = '';

    if(queue.length === 0){
      emptyState.style.display = 'block';
      document.getElementById('studentTable').style.display = 'none';
    } else {
      emptyState.style.display = 'none';
      document.getElementById('studentTable').style.display = 'table';
    }

    queue.forEach(function(rec, idx){
      const tr = document.createElement('tr');

      const isFront = idx === 0;
      const isRear = idx === queue.length - 1;
      const tagHtml =
        (isFront ? '<span class="tag tag-front">Front</span>' : '') +
        (isRear && !isFront ? '<span class="tag tag-rear">Rear</span>' : '');

      tr.innerHTML =
        '<td><span class="token">#' + String(rec.id).padStart(3,'0') + '</span>' + tagHtml + '</td>' +
        '<td><span class="name-cell">' + escapeHtml(rec.name) + '</span>' +
          '<span class="sub-cell">Roll ' + escapeHtml(rec.roll) + '</span></td>' +
        '<td>' + escapeHtml(rec.faculty) + '</td>' +
        '<td>' + escapeHtml(rec.semester) + '</td>' +
        '<td class="mono-cell">' + escapeHtml(rec.email) + '</td>' +
        '<td class="mono-cell">' + escapeHtml(rec.contact) + '</td>' +
        '<td><div class="row-actions">' +
          '<button class="icon-btn" data-action="edit" data-id="' + rec.id + '" title="Edit">✎</button>' +
          '<button class="icon-btn danger" data-action="delete" data-id="' + rec.id + '" title="Delete">🗑</button>' +
        '</div></td>';

      tableBody.appendChild(tr);
    });

    metaSize.textContent = queue.length;
    metaFront.textContent = queue.length ? ('#' + String(queue[0].id).padStart(3,'0') + ' ' + queue[0].name) : '—';
    metaRear.textContent = queue.length ? ('#' + String(queue[queue.length-1].id).padStart(3,'0') + ' ' + queue[queue.length-1].name) : '—';
  }

  tableBody.addEventListener('click', function(e){
    const btn = e.target.closest('button[data-action]');
    if(!btn) return;
    const id = Number(btn.getAttribute('data-id'));
    const action = btn.getAttribute('data-action');
    if(action === 'edit'){
      const rec = queue.find(r => r.id === id);
      if(rec) enterEditMode(rec);
    } else if(action === 'delete'){
      deleteStudent(id);
    }
  });

  function escapeHtml(str){
    return String(str).replace(/[&<>"']/g, function(c){
      return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];
    });
  }

  render();
})();
</script>
</body>
</html>